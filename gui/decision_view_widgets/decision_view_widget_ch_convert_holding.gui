# Decision view widget to convert holding into a different holding
# Required controller: create_holy_order
# CK3 1.20: the create_holy_order controller now exposes DecisionViewWidgetSelectBarony (Title instead of Capital), and
# decisions use title_valid instead of barony_valid.

flowcontainer = {
	name = "decision_view_widget_ch_convert_holding"
	direction = vertical
	minimumsize = { 514 -1 }
	maximumsize = { 514 -1 }
	ignoreinvisible = yes
	margin_top = 15

	flowcontainer = {
		visible = no # TODO [LS] TIT-6227 support custom names again

		direction = horizontal
		ignoreinvisible = yes
		parentanchor = hcenter

		text_single = {
			parentanchor = vcenter
			text = "CH_CONVERT_HOLDING_DECISION_NAME_LABEL"
		}

		widget = { size = { 15 0 } }

		editbox = {
			size = { 200 30 }
			parentanchor = vcenter
			alwaystransparent = no

			# TODO [LS] TIT-6227 support custom names again
			#text = "[DecisionViewWidgetSelectBarony.GetCurrentName]"
			#ontextedited = "[DecisionViewWidgetSelectBarony.OnEditCurrentName]"
		}
	}

	widget = {
		visible = no # TODO [LS] TIT-6227 support custom names again
		size = { 0 5 }
	}

	flowcontainer = {
		direction = horizontal
		ignoreinvisible = yes
		parentanchor = hcenter

		text_single = {
			visible = "[And(DecisionViewWidgetSelectBarony.IsCreate, DecisionViewWidgetSelectBarony.HasCurrentTitle)]"
			parentanchor = vcenter
			fontsize_min = 14
			text = "CH_CONVERT_HOLDING_DECISION_CAPITAL_LABEL"
		}

		text_single = {
			visible = "[And(DecisionViewWidgetSelectBarony.IsRevoke, DecisionViewWidgetSelectBarony.HasCurrentTitle)]"
			parentanchor = vcenter
			fontsize_min = 14
			text = "REVOKE_CH_CONVERT_HOLDING_DECISION_BARONY_LABEL"
		}

		spacer = {
			size = { 5 5 }
		}

		text_single = {
			visible = "[DecisionViewWidgetSelectBarony.HasCurrentTitle]"
			parentanchor = vcenter
			fontsize_min = 14
			default_format = "#high"
			text = "[DecisionViewWidgetSelectBarony.GetCurrentTitle.GetNameNoTier]"
		}

		widget = { size = { 15 0 } }

		button_standard = {
			name = "change_capital"
			minimumsize = { 200 0 }
			
			onclick = "[DecisionViewWidgetSelectBarony.OnSelectCapital]"
			clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_select"
			enabled = "[DecisionViewWidgetSelectBarony.HasValidTitles]"
			tooltip = "CH_SELECT_HOLDING_TOOLTIP"

			text_single = {
				text = "[SelectLocalization( DecisionViewWidgetSelectBarony.HasCurrentTitle, 'CH_CONVERT_HOLDING_DECISION_CHANGE_CAPITAL', 'CH_CONVERT_HOLDING_DECISION_SELECT_CAPITAL' )]"
				parentanchor = left|vcenter
				align = nobaseline
				position = { 10 0 }
				fontsize_min = 14
			}

			button_change = {
				visible = "[DecisionViewWidgetSelectBarony.HasCurrentTitle]"
				parentanchor = right|vcenter
				position = { -5 0 }
				alwaystransparent = yes
				size = { 25 25 }
			}

			button_select_arrow = {
				visible = "[Not(DecisionViewWidgetSelectBarony.HasCurrentTitle)]"
				parentanchor = right|vcenter
				position = { -5 0 }
				alwaystransparent = yes
				size = { 25 25 }
			}
		}
	}
}
