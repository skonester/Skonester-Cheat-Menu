# Skonester文化目录：传承 → 文化列表

window = {
  name = "skonester_acm_culture_picker_window"
  parentanchor = top|right
  position = { -720 80 }
  size = { 520 780 }
  layer = windows_layer
  filter_mouse = all
  allow_outside = yes
  alwaystransparent = no
  movable = yes

  using = Window_Background
  using = Window_Decoration

  datacontext = "[GetVariableSystem]"
  datacontext = "[GetPlayer]"

  visible = "[GetScriptedGui('skonester_acm_culture_picker_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

  state = {
    name = init_region
    trigger_on_create = yes
    on_start = "[GetVariableSystem.Set('skonester_acm_culture_region', 'all')]"
  }

  state = {
    name = init_load
    trigger_on_create = yes
    on_start = "[GetScriptedGui('skonester_acm_culture_list_load').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
  }

  vbox = {
    using = Window_Margins
    layoutpolicy_horizontal = expanding
    layoutpolicy_vertical = expanding
    spacing = 6

    header_pattern = {
      layoutpolicy_horizontal = expanding
      blockoverride "header_text" {
        text = skonester_acm_culture_picker_title
      }
      blockoverride "button_close" {
        onclick = "[GetScriptedGui('skonester_acm_culture_picker_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      }
    }

    vbox = {
      layoutpolicy_horizontal = expanding
      margin = { 12 0 }
      spacing = 2

      text_single = {
        layoutpolicy_horizontal = expanding
        text = skonester_acm_culture_picker_subtitle
        default_format = "#high"
        autoresize = yes
        max_width = 480
      }

      text_single = {
        layoutpolicy_horizontal = expanding
        text = skonester_acm_culture_picker_hint
        default_format = "#weak"
        autoresize = yes
        max_width = 480
      }
    }

    vbox = {
      layoutpolicy_horizontal = expanding
      layoutpolicy_vertical = expanding
      spacing = 4

      text_single = {
        layoutpolicy_horizontal = expanding
        text = skonester_acm_culture_picker_list_caption
        default_format = "#low"
        autoresize = yes
      }

      scrollbox = {
        layoutpolicy_vertical = expanding
        layoutpolicy_horizontal = expanding

        blockoverride "scrollbox_content" {
          vbox = {
            name = "cultures"
            layoutpolicy_horizontal = expanding
            datamodel = "[GetGlobalList(Concatenate('skonester_acm_heritage_list_', GetVariableSystem.Get('skonester_acm_culture_region')))]"

            item = {
              vbox = {
                name = "culture_group"
                layoutpolicy_horizontal = expanding
                datacontext = "[Scope.Culture.GetHeritage]"
                margin_bottom = 4

                button_standard_hover = {
                  layoutpolicy_horizontal = expanding
                  size = { 0 38 }
                  onclick = "[GetVariableSystem.Toggle(ConcatIfNeitherEmpty(CulturePillar.GetNameNoTooltip,'children_visible'))]"
                  tooltip = RULER_DESIGNER_LIST_CULTURE_ENTRY_TOOLTIP

                  background = {
                    texture = "gfx/interface/component_tiles/tile_title_bg_01.dds"
                    spriteType = Corneredstretched
                    spriteborder = { 8 8 }
                    alpha = 0.55
                  }

                  hbox = {
                    margin = { 8 0 }
                    spacing = 8

                    button_list_expand = {
                      checked = "[GetVariableSystem.Exists(ConcatIfNeitherEmpty(CulturePillar.GetNameNoTooltip,'children_visible'))]"
                      onclick = "[GetVariableSystem.Toggle(ConcatIfNeitherEmpty(CulturePillar.GetNameNoTooltip,'children_visible'))]"
                    }

                    text_single = {
                      layoutpolicy_horizontal = expanding
                      text = "[CulturePillar.GetNameNoTooltip]"
                      default_format = "#high"
                      autoresize = no
                    }
                  }
                }

                vbox = {
                  name = "cultures"
                  layoutpolicy_horizontal = expanding
                  datamodel = "[CulturePillar.GetCulturesWithPillar]"
                  visible = "[GetVariableSystem.Exists(ConcatIfNeitherEmpty(CulturePillar.GetNameNoTooltip,'children_visible'))]"
                  margin_left = 12

                  item = {
                    hbox = {
                      layoutpolicy_horizontal = expanding
                      datacontext = "[Culture.GetTemplate]"

                      button_standard_hover = {
                        name = "culture_item"
                        layoutpolicy_horizontal = expanding
                        size = { 0 32 }
                        tooltipwidget = {
                          ruler_designer_culture_tooltip = {}
                        }
                        onclick = "[GetScriptedGui('skonester_acm_culture_pick').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_culture', Culture.MakeScope).End)]"

                        hbox = {
                          margin = { 4 0 }
                          spacing = 6

                          text_single = {
                            raw_text = "—"
                            default_format = "#weak"
                            align = nobaseline
                          }

                          text_single = {
                            margin = { 2 0 }
                            layoutpolicy_horizontal = expanding
                            text = "[Culture.GetNameNoTooltip]"
                            default_format = "#clickable"
                            align = nobaseline
                          }

                          button_round = {
                            size = { 26 26 }
                            tooltip = skonester_acm_culture_picker_open_vanilla_tt
                            onclick = "[GetScriptedGui('skonester_acm_culture_pick_vanilla').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_culture', Culture.MakeScope).End)]"
                            raw_text = "»"
                            default_format = "#high"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }

    hbox = {
      layoutpolicy_horizontal = expanding
      margin = { 8 4 }
      spacing = 8

      button_standard = {
        layoutpolicy_horizontal = expanding
        text = skonester_acm_culture_picker_footer_edit
        tooltip = skonester_acm_culture_picker_footer_edit_tt
        onclick = "[GetScriptedGui('skonester_acm_culture_picker_continue_edit').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      }
    }
  }
}
