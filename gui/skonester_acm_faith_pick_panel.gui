# 教义替换列表面板（布局同创建新信仰右侧），配合本体 window_faith 使用

window = {
  name = "skonester_acm_faith_pick_panel_window"
  widgetid = "skonester_acm_faith_pick_panel_window"
  parentanchor = top|right
  position = { -1240 80 }
  movable = yes
  layer = middle
  filter_mouse = all
  allow_outside = yes
  minimumsize = { 480 400 }
  size = { 500 700 }

  using = Window_Background_Sidebar

  datacontext = "[GetVariableSystem]"
  datacontext = "[GetPlayer.MakeScope.Var('skonester_selected_faith_var').Faith]"

  visible = "[GetScriptedGui('skonester_acm_faith_pick_sidebar_visible').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

  vbox = {
    using = Window_Margins_Sidebar
    layoutpolicy_horizontal = expanding
    layoutpolicy_vertical = expanding
    spacing = 8

    header_pattern = {
      layoutpolicy_horizontal = expanding

      blockoverride "header_text" {
        text = skonester_acm_faith_editor_pick_heading
      }

      blockoverride "button_close" {
        onclick = "[GetVariableSystem.Clear( 'skonester_acm_faith_right_view' )]"
        onclick = "[GetScriptedGui('skonester_acm_faith_pick_sidebar_hide').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      }
    }

    text_label_center = {
      layoutpolicy_horizontal = expanding
      text = "[VariableSystem.Get( 'doctrine_group_name' )]"
      max_width = 420
    }

    text_single = {
      layoutpolicy_horizontal = expanding
      text = skonester_acm_faith_editor_pick_hint
      default_format = "#weak"
      align = center
      autoresize = yes
      max_width = 420
    }

    scrollbox = {
      name = "contents"
      layoutpolicy_horizontal = expanding
      layoutpolicy_vertical = expanding

      blockoverride "scrollbox_content" {
        vbox = {
          layoutpolicy_horizontal = expanding
          spacing = 4

          text_single = {
            visible = "[IsDataModelEmpty( GetGlobalList('skonester_acm_fe_pick_current') )]"
            layoutpolicy_horizontal = expanding
            text = skonester_acm_faith_editor_pick_empty
            default_format = "#weak"
            align = center
            autoresize = yes
            max_width = 420
          }

          # CK3 1.20: tenets and doctrines are different data types, so the pick list is split in two.
          vbox = {
            layoutpolicy_horizontal = expanding
            visible = "[Not( GetScriptedGui('skonester_acm_faith_pick_is_tenets').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
            datamodel = "[GetGlobalList('skonester_acm_fe_pick_current')]"

            item = {
              flowcontainer = {
                layoutpolicy_horizontal = expanding
                datacontext = "[GetDoctrineType( Scope.GetFlagName )]"
                datacontext = "[GetPlayer.MakeScope.Var('skonester_selected_faith_var').Faith]"

                skonester_acm_faith_creation_pick_row = {}

                divider_light = {
                  layoutpolicy_horizontal = expanding
                }
              }
            }
          }
          vbox = {
            layoutpolicy_horizontal = expanding
            visible = "[GetScriptedGui('skonester_acm_faith_pick_is_tenets').IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
            datamodel = "[GetGlobalList('skonester_acm_fe_pick_current')]"

            item = {
              flowcontainer = {
                layoutpolicy_horizontal = expanding
                datacontext = "[GetTenetType( Scope.GetFlagName )]"
                datacontext = "[GetPlayer.MakeScope.Var('skonester_selected_faith_var').Faith]"

                skonester_acm_faith_creation_pick_row_tenet = {}

                divider_light = {
                  layoutpolicy_horizontal = expanding
                }
              }
            }
          }
        }
      }
    }

    button_standard = {
      name = "cancel"
      onclick = "[GetVariableSystem.Clear( 'skonester_acm_faith_right_view' )]"
      onclick = "[GetScriptedGui('skonester_acm_faith_pick_sidebar_hide').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
      text = "CANCEL"
      default_format = "#high"
    }
  }
}

types skonesterAcmFaithPickPanelTypes
{
  type skonester_acm_faith_creation_pick_row = button_standard_hover {
    name = "faith_list_item"
    layoutpolicy_horizontal = expanding
    datacontext = "[DoctrineType]"
    datacontext = "[Faith]"
    datacontext = "[Faith.GetMainRite]"
    size = { 430 80 }

    onclick = "[GetScriptedGui('skonester_acm_faith_apply_pick_doctrine').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pick_doctrine', MakeScopeFlag(Scope.GetFlagName)).End)]"
    onclick = "[GetVariableSystem.Clear( 'skonester_acm_faith_right_view' )]"
    onclick = "[GetScriptedGui('skonester_acm_faith_pick_sidebar_hide').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[PdxGuiTriggerAllAnimations('faith_view_refresh')]"
    down = "[Faith.HasDoctrine( DoctrineType.Self )]"
    using = tooltip_es # this list sits left of the faith window; open the tooltip to its right, not over the choices
    tooltip = "skonester_acm_faith_doctrine_select_tt"

    icon_doctrine = {
      name = "doctrine_icon_main"
      visible = "[DoctrineType.GetGroup.GetCategory.HasTag( 'main' )]"
      texture = "[DoctrineType.GetIcon]"
      size = { 60 60 }
      position = { 5 10 }
    }

    icon_doctrine = {
      name = "doctrine_icon_other"
      visible = "[Not( DoctrineType.GetGroup.GetCategory.HasTag( 'main' ) )]"
      texture = "[DoctrineType.GetGroup.GetIcon]"
      size = { 60 60 }
      position = { 5 10 }
    }

    text_single = {
      name = "doctrine_name"
      position = { 75 25 }
      text = "[DoctrineType.GetNameNoTooltip( Faith.Self )]"
      default_format = "#high"
      using = Font_Size_Medium
      max_width = 270
    }
    # CK3 1.20: CalcPietyCostWithFervorDiscount no longer exists (piety costs are computed during Rite creation).
  }

  # CK3 1.20: tenets are TenetType (no longer FaithDoctrine); names/effects are evaluated against the faith's main Rite.
  type skonester_acm_faith_creation_pick_row_tenet = button_standard_hover {
    name = "faith_list_item_tenet"
    layoutpolicy_horizontal = expanding
    datacontext = "[TenetType]"
    datacontext = "[Faith]"
    datacontext = "[Faith.GetMainRite]"
    size = { 430 80 }

    onclick = "[GetScriptedGui('skonester_acm_faith_apply_pick_doctrine').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('pick_doctrine', MakeScopeFlag(Scope.GetFlagName)).End)]"
    onclick = "[GetVariableSystem.Clear( 'skonester_acm_faith_right_view' )]"
    onclick = "[GetScriptedGui('skonester_acm_faith_pick_sidebar_hide').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    onclick = "[PdxGuiTriggerAllAnimations('faith_view_refresh')]"
    down = "[Faith.GetMainRite.HasTenet( TenetType.Self )]"
    using = tooltip_es # this list sits left of the faith window; open the tooltip to its right, not over the choices
    tooltip = "FAITH_WINDOW_TENET_TOOLTIP"

    widget = {
      name = "doctrine_icon_core_bg"

      background = {
        using = Background_Area_Dark
        alpha = 0.4
      }

      size = { 45 70 }
      position = { 15 5 }
    }

    icon = {
      name = "doctrine_icon_core"
      texture = "[TenetType.GetIcon( Faith.Self )]"
      size = { 45 70 }
      position = { 15 5 }
    }

    text_single = {
      name = "doctrine_name"
      position = { 75 25 }
      text = "[TenetType.GetNameNoTooltip( Rite.Self )]"
      default_format = "#high"
      using = Font_Size_Medium
      max_width = 270
    }
  }
}
