      state = {
        name = skonester_acm_name_preview_refresh
        trigger_when = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('skonester_acm_gui_preview_tick').GetValue, '(CFixedPoint)0' )]"
      }
    }
    text_single = {
      layoutpolicy_horizontal = expanding
      max_width = 520
      default_format = "#weak"
      raw_text = "[Localize('skonester_acm_edit_gui_desc_preview_prefix')][GetPlayer.Custom('skonester_acm_edit_desc_preview_display')]"

      state = {
        name = skonester_acm_desc_preview_refresh
        trigger_when = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('skonester_acm_gui_preview_tick').GetValue, '(CFixedPoint)0' )]"
      }
    }

    button_standard = {
      layoutpolicy_horizontal = expanding
      text = "skonester_acm_gui_close_button"
      onclick = "[GetScriptedGui('skonester_acm_gui_close').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
    }

    button_primary = {
      layoutpolicy_horizontal = expanding
      size = { 0 44 }
      text = "skonester_acm_gui_create"
      onclick = "[GetScriptedGui( 'skonester_acm_gui_create' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
    }
  }
}
