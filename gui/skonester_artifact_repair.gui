window = {
  name = "skonester_artifact_repair_window"
  parentanchor = top|right
  position = { -32 48 }
  using = Window_Size_MainTab
  minimumsize = { 720 520 }
  maximumsize = { 820 1200 }
  size = { 760 1080 }
  layer = top
  movable = yes
  alwaystransparent = no
  filter_mouse = all
  allow_outside = no
  visible = "[GetScriptedGui( 'skonester_acm_repair_gui_open_visible' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

