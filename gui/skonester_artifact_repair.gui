        text = "skonester_acm_edit_gui_window_title"
      }
      blockoverride "button_close" {
        onclick = "[GetScriptedGui('skonester_acm_repair_gui_close').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
      }
    }

