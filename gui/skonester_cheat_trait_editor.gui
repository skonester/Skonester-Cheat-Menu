window = {
  name = "skonester_cheat_trait_editor_window"
  parentanchor = center
  position = { 0 0 }
  size = { 720 640 }
  layer = top
  filter_mouse = all
  allow_outside = no
  alwaystransparent = no
  movable = yes

  widget = {
    parentanchor = fill
    size = { 100% 100% }
    background = {
      using = Background_Area_Dark
      alpha = 1.0
    }
  }

