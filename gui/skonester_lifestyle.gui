window = {
  name = "skonester_lifestyle_gui_window"
  parentanchor = center
  position = { 0 0 }
  size = { 980 720 }
  layer = top
  filter_mouse = all
  allow_outside = no
  alwaystransparent = no
  movable = yes

  widget = {
    parentanchor = fill
    size = { 100% 100% }
    background = {
      using = Background_Area_Dark
      alpha = 1.0
    }
  }

