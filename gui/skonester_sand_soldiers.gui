                      spacing = 10
                      highlight_icon = {
                        alwaystransparent = yes
                        size = { 40 40 }
                        texture = "gfx/interface/icons/regimenttypes/pikemen.dds"
                      }
                      text_single = {
                        alwaystransparent = yes
                        layoutpolicy_horizontal = expanding
                        text = maa_thieves
                        default_format = "#clickable"
                        autoresize = no
                        max_width = 312
                      }
                    }
                  }
