                    down = "[GetScriptedGui('skonester_sand_is_picked_maa').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('maa_flag', MakeScopeFlag('maa_thieves')).End)]"
                    background = {
