						alwaystransparent = "[GreaterThan_CFixedPoint( GetPlayer.MakeScope.Var('disable_clicking_portraits').GetValue, '(CFixedPoint)0' )]"
					}

				}

				flowcontainer = {
					parentanchor = top|hcenter
					position = { -3 88 }
					ignoreinvisible = yes
					spacing = 3

					background = {
						margin_left = 20
						margin_right = 20

						texture = "gfx/interface/component_tiles/tile_title_bg_01.dds"
