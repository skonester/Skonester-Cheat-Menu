	button_standard = { name = "skonester_crozier_cheats_xray" visible = "[Not( GetVariableSystem.Exists( 'skonester_crozier_cheats_hide' ) )]" parentanchor = top|right position = { -208 8 } size = { 86 30 } tooltip = "SKONESTER_CROZIER_CHEATS_XRAY_TT" onclick = "[GetVariableSystem.Toggle( 'skonester_crozier_cheats_xray_open' )]" down = "[GetVariableSystem.Exists( 'skonester_crozier_cheats_xray_open' )]" text_single = { parentanchor = center text = "SKONESTER_CROZIER_CHEATS_XRAY" using = Font_Size_Small } }
