				spacing = 3

				expand = {}

				icon = {
					size = { 30 30 }

					texture = "[Character.GetLegitimacyType.GetLevelsIcon]"
					framesize = { 70 70 }
					frame = "[IntToFrameIndex( LegitimacyLevel.GetIndex )]"
				}

				text_single = {
					text = CHARACTER_WINDOW_LEGITIMACY_LEVEL
					align = nobaseline
				}

				expand = {}
			}
