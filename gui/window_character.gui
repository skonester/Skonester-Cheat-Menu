						coat_of_arms_slot = "[Organization.GetOrganizationCoA.GetSlot('(int32)56','(int32)56')]"
						coat_of_arms_mask = "gfx/interface/coat_of_arms/frames/house_frame_05_mask.dds"

						coa_house_frame = {
							size = { 55 55 }
