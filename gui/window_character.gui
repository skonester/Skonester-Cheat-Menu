		divider_light = {
			visible = "[Or( Character.ShouldShowLegitimacy, Character.ShouldShowMerit )]"
			layoutpolicy_vertical = expanding
		}

		#Legitimacy
		widget = {
			datacontext = "[Character.GetLegitimacyType]"
			datacontext = "[Character.GetLegitimacyLevel]"
			visible = "[Character.ShouldShowLegitimacy]"
			size = { 72 32 }

			tooltipwidget = {
				legitimacy_hud_tooltip = {
					datacontext = "[CharacterWindow.GetLegitimacyBar]"
				}
			}

			using = tooltip_se

