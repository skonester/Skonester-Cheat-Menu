	button_standard = { name = "skonester_crozier_cheats_open_char_other" visible = "[And( Not( Character.IsLocalPlayer ), Not( GetVariableSystem.Exists( 'skonester_crozier_cheats_hide' ) ) )]" parentanchor = top|right position = { -118 8 } size = { 86 30 } shortcut = _ctrl_shift_x tooltip = "SKONESTER_CROZIER_CHEATS_OPEN_TT" onclick = "[GetVariableSystem.Toggle( 'skonester_crozier_cheats_open_char_other' )]" down = "[GetVariableSystem.Exists( 'skonester_crozier_cheats_open_char_other' )]" text_single = { parentanchor = center text = "SKONESTER_CROZIER_CHEATS_OPEN" using = Font_Size_Small } }

