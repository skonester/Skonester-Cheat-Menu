											blockoverride "description_prefix" {
												text_single = {
													layoutpolicy_horizontal = expanding
													text = "house_relation_your_relation_with"
													default_format = "#weak"
													align = left
												}
											}
										}
									}
								}

								spacer = {
									size = { 0 10 }
								}
							}
						}
					}

					text_multi = {
						autoresize = yes
						maximumsize = { 118 50 }
						text = "[DynastyHouse.GetBaseNameNoTooltip]"
						default_format = "#high"
