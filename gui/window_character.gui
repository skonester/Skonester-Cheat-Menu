					parentanchor = top|hcenter
					position = { 0 85 }
					text = "[host|E]"
				}


				portrait_opinion = {
					name = "liege_opinion"
					datacontext = "[CharacterWindow.GetCharacter]"
					visible = "[And(Character.IsAlive, Not(Character.IsLocalPlayer))]"
