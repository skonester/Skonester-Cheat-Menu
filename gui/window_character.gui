				onclick = "[GetVariableSystem.Clear('relations')]"
				onclick = "[GetVariableSystem.Clear('court')]"
				onclick = "[GetVariableSystem.Clear('subjects')]"
				onclick = "[GetVariableSystem.Clear('subordinates')]"
				shortcut = "tab_1"
				#onclick = "[CharacterWindow.SetActiveTab('family')]"

				### Added on creation triggers for the default tab to trigger expand animation when opening the window for the first time
				oncreate = "[PdxGuiWidget.TriggerAnimation('tab_active')]"
				oncreate = "[PdxGuiWidget.FindChild('tab_name').TriggerAnimation('tab_name_hidden')]"

				alwaystransparent = "[CharacterWindow.IsTabShown('family')]"

