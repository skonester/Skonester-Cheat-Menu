						text = "[player_heir|E]"
						align = nobaseline
						default_format = "#medium"
						parentanchor = vcenter
						fontsize_min = 12
					}
				}
			}

			widget = { # Primary Heir for everyone else
				name = "heir_primary"
				datacontext = "[CharacterWindow.GetCharacter.GetPrimaryTitle.GetHeir]"
